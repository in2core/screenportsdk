t":") -> "},{"preciseIdentifier":"s:13ScreenPortSDK18StreamSubscriptionC","kind":"typeIdentifier","text":"StreamSubscription"}]},"sections":[],"abstract":[{"type":"text","text":"Subscribes to source media of the specified types. Retain the returned subscription."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["Mac Catalyst"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"subscribe","kind":"identifier"},{"text":"(","kind":"text"},{"text":"to","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"mediaTypes","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"CMMediaType","preciseIdentifier":"c:@T@CMMediaType"},{"kind":"text","text":"> = [kCMMediaType_Video, kCMMediaType_Audio], "},{"kind":"externalParam","text":"connectionType"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"ConnectionType","identifier":"doc:\/\/com.in2core.ScreenPortSDK\/documentation\/ScreenPortSDK\/ConnectionType","preciseIdentifier":"s:13ScreenPortSDK14ConnectionTypeV"},{"kind":"text","text":" = .auto, "},{"kind":"externalParam","text":"queue"},{"kind":"text","text":": "},{"text":"DispatchQueue","preciseIdentifier":"c:objc(cs)OS_dispatch_queue","kind":"typeIdentifier"},{"text":" = .global(qos: .userInitiated), ","kind":"text"},{"text":"bufferCapacity","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":" = 8, ","kind":"text"},{"text":"receive","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"@escaping","kind":"attribute"},{"text":" (","kind":"text"},{"text":"StreamSubscription","identifier":"doc:\/\/com.in2core.ScreenPortSDK\/documentation\/ScreenPortSDK\/StreamSubscription","pre